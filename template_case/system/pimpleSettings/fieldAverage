fieldAverages
    {
        type            fieldAverage;
        libs            ("libfieldFunctionObjects.so");
        writeControl    writeTime;

        restartOnRestart false;
        restartOnOutput  false;

        fields
        (
            // Flow velocity (mean and Reynolds stresses for turbulence ML data)
            U
            {
                mean            on;
                prime2Mean      on;
                base            time;
            }
            
            // Static pressure
            p
            {
                mean            on;
                prime2Mean      on;
                base            time;
            }

            // Pressure Coefficient
            Cp
            {
                mean            on;
                prime2Mean      off;
                base            time;
            }

            // Turbulent Kinetic Energy (k-omega SST-LM)
            k
            {
                mean            on;
                prime2Mean      off;
                base            time;
            }

            // Specific Dissipation Rate
            omega
            {
                mean            on;
                prime2Mean      off;
                base            time;
            }

            // Intermittency (SST-LM transition model)
            gamma
            {
                mean            on;
                prime2Mean      off;
                base            time;
            }

            // Transition momentum-thickness Reynolds number
            ReThetat
            {
                mean            on;
                prime2Mean      off;
                base            time;
            }

            // Wall Shear Stress (boundary layer / skin friction data)
            wallShearStress
            {
                mean            on;
                prime2Mean      off;
                base            time;
            }
        )
    }