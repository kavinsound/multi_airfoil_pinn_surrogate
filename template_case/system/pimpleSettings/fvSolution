FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver           GAMG;
        smoother         GaussSeidel;
        tolerance        1e-6;
        relTol           0.01;
    }

    pFinal
    {
        $p;
        relTol          0;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-05;
        relTol          0.1;
    }

    UFinal
    {
        $U;
        relTol          0;
    }

    Phi
    {
        $p;
    }

    "(U|k|omega|gammaInt|ReThetat)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.1; // Allows quick inner loop steps
    }

    "(U|k|omega|gammaInt|ReThetat)Final"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0;   // Force absolute convergence on the final PIMPLE loop
    }

}

PIMPLE
{
    nOuterCorrectors     1;      
    nCorrectors          1;      
    nNonOrthogonalCorrectors 1;

    pRefCell             0;
    pRefValue            0;

    residualControl
    {
        "(p|U|k|omega|ReThetat|gammaInt)"
        {
            tolerance 1e-4;
            relTol 0.05;
        }
    }  
}


relaxationFactors
{
   fields
    {
        p           0.3;
    }
    equations
    {
        Ux          0.7;
        Uy          0.7;
        U           0.7;
        k           0.7;
        omega       0.7;
        ReThetat    0.7; // Lower this if it's stalling
        gammaInt    0.7; // Same for intermittency
    } 


}

cache
{
    grad(U);
}


