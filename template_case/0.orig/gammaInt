FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      gammaInt;
}

dimensions      [0 0 0 0 0 0 0];
internalField   uniform 1;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1;
    }
    outlets
    {
        type            inletOutlet;
        inletValue      uniform 1;
        value           uniform 1;
    }
    
    airfoils
    {
        type            zeroGradient; // or fixedValue uniform 1; depending on OpenFOAM version
    }
    

    frontAndBack
    {
        type            empty;
    }
}