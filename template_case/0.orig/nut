FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0; // Starts at zero (or a very small laminar value)

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }

    outlets
    {
        type            calculated;
        value           uniform 0;
    }

    // Use your group or list for the airfoils
    airfoils
    {
        type            nutkWallFunction; 
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
    
}