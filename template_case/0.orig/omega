FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 1.0;

boundaryField
{
    inlet
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.07;            
        U               U;
        value           uniform 1.0;     // Placeholder initialization value
    }
    outlets
    {
        type            zeroGradient;
    }
    
    airfoils
    {
        type            omegaWallFunction; // Automatically switches handles for y+ < 1
        value           uniform 1.0;
    }

    frontAndBack
    {
        type            empty;
    }
    
}